# 复制为 .env 并按服务器实际情况修改

# 业务库（只读账号）：mysql+pymysql://只读账号:密码@127.0.0.1/业务库名?charset=utf8mb4
DATABASE_URL=sqlite:///./demo.db
# 程序库（用户/授权表）：mysql+pymysql://app账号:密码@127.0.0.1/dv_app?charset=utf8mb4
APP_DB_URL=sqlite:///./app.db

# 生产必须改成随机长字符串，例如: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=12

# AI 自由问答（云端 OpenAI 兼容接口；未配置或 AI_ENABLED=false 时接口不可用）
# 示例：DeepSeek https://api.deepseek.com/v1 ；通义 compatible-mode 等
AI_ENABLED=false
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MAX_TOOL_ROUNDS=4
AI_RATE_LIMIT_PER_MIN=10
